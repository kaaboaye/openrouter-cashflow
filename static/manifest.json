{
  "manifest_version": 3,
  "name": "OpenRouter Cashflow",
  "version": "0.1.0",
  "description": "See who earns what on OpenRouter: estimated revenue per hosting provider, model, author and app, right inside openrouter.ai.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://openrouter.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://openrouter.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
